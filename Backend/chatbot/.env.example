# Smart Sukuk RAG Chatbot — Environment Variables

# Ollama Cloud LLM
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss-20b
OLLAMA_API_TOKEN=your_api_token_here

# Embedding Model (default: all-MiniLM-L6-v2)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# LLM Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# RAG Pipeline
RETRIEVAL_SCORE_THRESHOLD=0.3
RETRIEVAL_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Rate Limiting
RATE_LIMIT_AUTHENTICATED=30/minute
RATE_LIMIT_ANONYMOUS=10/minute

# Server
CHATBOT_HOST=0.0.0.0
CHATBOT_PORT=8001

# CORS
EXPRESS_BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
